{
  "name": "@quadrantcapital/venue-runner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.9.2",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint -c eslint.config.mjs \"src/**/*.ts\"",
    "audit:deps": "yarn npm audit -R --severity high --environment production"
  },
  "dependencies": {
    "@nats-io/nats-core": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "@quadrantcapital/proto": "0.11.89",
    "@quadrantcapital/wire": "1.0.390",
    "axios": "^1.19.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "ws": "^8.22.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nats-io/jwt": "0.0.11",
    "@nats-io/nkeys": "2.0.3",
    "@types/node": "^22.20.4",
    "@types/ws": "^8",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
