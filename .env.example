# The venue runner's settings. `install.sh` writes `.env` from its arguments; or copy this file to
# `.env` and fill it in. Keep `.env` private: the token is the runner's password.

# Your Qvantera platform's address, as you open it in the browser.
QV_PLATFORM_URL=https://qvantera.example.com

# The token shown once when the runner was registered (the Runners page, or `qv runners register`).
QV_RUNNER_TOKEN=

# Which of this host's addresses the runner sends from — each is a separate lane, and the venue
# counts its per-address limits on each one. `auto`: every public address of the host (or its
# default route when it has none). Or a list: RUNNER_EGRESS_IPS=203.0.113.10,203.0.113.11
# Every address you use must be whitelisted at the venue.
RUNNER_EGRESS_IPS=auto

# Optional. A plain-text "what is my IP" service, asked through each lane, so a host behind NAT
# reports the address the venue actually sees. Without it, a public address is reported as itself.
# RUNNER_EGRESS_IP_URL=https://api.ipify.org

# Optional. A name for this host in the runner's own logs.
# RUNNER_NAME=

# Optional. The image tag; `latest` is the newest release.
# QV_RUNNER_VERSION=latest

# Optional. The local port of /health and /metrics, on 127.0.0.1 only.
# RUNNER_PORT=3005
